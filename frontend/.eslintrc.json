{
  "root": true,
  "extends": ["plugin:vue/vue3-essential", "eslint:recommended"],
  "rules": {
    "vue/no-v-model-argument": "off",
    "vue/no-v-model-arguments": "off"
  },
  "overrides": [
    {
      "files": ["*.vue"],
      "rules": {
        "vue/no-v-model-argument": "off",
        "vue/no-v-model-arguments": "off"
      }
    }
  ]
}
